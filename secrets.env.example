# Your keys. Copy this file to secrets.env (setup does it for you) and paste each key after the =.
# One per line, no quotes, no spaces. secrets.env is in .gitignore: it never gets uploaded.
# Windows: you can also set these as environment variables instead (setx NAME "value").

# Threads: run  python mac/threads-login.py  (any OS) for a full token, or Meta app > Threads > User Token Generator
THREADS_TOKEN=
THREADS_APP_SECRET=
# Instagram/Facebook: run  python machine.py setup-instagram
INSTAGRAM_TOKEN=
# TikTok developer portal > your app > (Sandbox until approved) > Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
